# ==============================================================================
# ContextGPT Environment Configuration Example
# Copy this file to .env and configure values before starting the application:
#   cp .env.example .env
# ==============================================================================

# Application Settings
APP_NAME=ContextGPT
APP_ENV=development
LOG_LEVEL=INFO

# AI & LLM Model Configuration (Supports OpenAI, NVIDIA NIM, Groq, Ollama)
# For NVIDIA NIM: set OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1 and OPENAI_API_KEY=nvapi-...
# For OpenAI: leave OPENAI_BASE_URL blank and use your sk-... key
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
EMBEDDING_MODEL=


# Database Configuration (PostgreSQL only)
POSTGRES_DB=contextgpt
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/contextgpt

# Authentication & Security
# Generate a secure secret using: openssl rand -hex 32
JWT_SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Networking & CORS
API_BASE_URL=http://localhost:8000
BACKEND_CORS_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501"]

# RAG & Content Processing Parameters
MAX_UPLOAD_SIZE_MB=20
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
